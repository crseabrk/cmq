<UserControl x:Class="CMQ.Windows.FilePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360">
    <Grid Margin="8,8,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DrivePicker" Grid.Column="0" Height="30"
                      SelectionChanged="DrivePicker_SelectionChanged"/>
            <Button x:Name="BackButton" Grid.Column="1" Content="‹" FontSize="17"
                    ToolTip="Back" Click="BackButton_Click"/>
            <Button x:Name="ForwardButton" Grid.Column="2" Content="›" FontSize="17"
                    ToolTip="Forward" Click="ForwardButton_Click"/>
            <Button x:Name="UpButton" Grid.Column="3" Content="↑" FontSize="17"
                    ToolTip="Up" Click="UpButton_Click"/>
            <TextBox x:Name="PathBox" Grid.Column="4" Height="30" Margin="5,0,0,0"
                     VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
        </Grid>

        <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Extended"
                  AllowDrop="True" SelectionChanged="FileList_SelectionChanged"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  DragOver="FileList_DragOver" Drop="FileList_Drop">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding DisplaySize}"/>
                    <GridViewColumn Header="Modified" Width="145" DisplayMemberBinding="{Binding DisplayModified}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ProgressBar x:Name="TransferProgress" Grid.Row="3" Height="8" Margin="0,7,0,3"
                     Visibility="Collapsed" Minimum="0" Maximum="1"/>
        <TextBlock x:Name="StatusText" Grid.Row="4" Height="18" FontSize="11"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
