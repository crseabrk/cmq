<Window x:Class="CMQ.Windows.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File conflict" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinWidth="560">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock x:Name="Details" Grid.Row="1" TextWrapping="Wrap" MaxWidth="650" Margin="0,0,0,14"/>
        <CheckBox x:Name="ApplyToAll" Grid.Row="2" Margin="0,0,0,18"/>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="MergeButton" Content="Merge Folders" Padding="14,5" Margin="4,0" Click="Merge_Click"/>
            <Button Content="Replace" Padding="14,5" Margin="4,0" Click="Replace_Click"/>
            <Button Content="Keep Both" Padding="14,5" Margin="4,0" Click="KeepBoth_Click"/>
            <Button Content="Skip" Padding="14,5" Margin="4,0" Click="Skip_Click"/>
            <Button Content="Cancel Transfer" Padding="14,5" Margin="4,0" IsCancel="True" Click="Cancel_Click"/>
        </WrapPanel>
    </Grid>
</Window>
